{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/withings-sync",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/daily-metric-check",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/brief?kind=weekly",
      "schedule": "0 23 * * 0"
    },
    {
      "path": "/api/cron/brief?kind=daily",
      "schedule": "30 10 * * 1-5"
    }
  ]
}
