[Unit]
# Harvests what every bot did from ~/dev/brain into Mission Control's
# /activity page. USER unit, same as mission-control-sync: it reads the
# user's brain checkout and writes only this app's own database.
Description=Mission Control — bot activity harvest
Documentation=file:///home/admxn/dev/mission-control/docs/bot-activity.md
After=network-online.target
Wants=network-online.target
# Five failures in ten minutes and it stops retrying until the next timer
# tick, rather than hammering a database that is down.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=oneshot

# The same secrets file as the project sync (mode 600, never committed).
EnvironmentFile=%h/.config/mission-control/sync.env

WorkingDirectory=%h/dev/mission-control

# The brain push (activity-deliver, decisions-inbox) goes over ssh. Inside
# this sandbox /etc/ssh/ssh_config.d/* appears with a foreign owner and ssh
# refuses it ("Bad owner or permissions"), so every push failed until
# 2026-10-30. -F reads only the user's own config and skips the system one.
Environment="GIT_SSH_COMMAND=ssh -F %h/.ssh/config"

# Absolute path: a user unit does not source ~/.profile, so fnm's shims are
# absent and a bare `node` fails with 203/EXEC. See docs/runbook.md.
ExecStart=/home/admxn/.local/share/fnm/aliases/default/bin/node scripts/sync/activity.ts
# v3: deliver Eric's /activity decisions to the bots that asked, right after
# the harvest. The leading '-' keeps a delivery failure from failing the
# harvest; the row keeps delivery_error and is retried on the next run.
ExecStartPost=-/home/admxn/.local/share/fnm/aliases/default/bin/node scripts/sync/activity-deliver.ts
# Decisions inbox: ingest `kind: decision` notes and stalled jobs into
# mission.decisions, then deliver Eric's answers as `kind: answer` notes and
# ring Chief of Staff's doorbell. docs/decisions-inbox.md.
ExecStartPost=-/home/admxn/.local/share/fnm/aliases/default/bin/node scripts/sync/decisions-inbox.ts

Restart=on-failure
RestartSec=60

# Reads the brain, writes Supabase. Nothing more. loops-report.py runs in its
# read-only report mode, so a read-only home is enough.
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# ~/scratch: the brain scratch clone delivery commits through (never ~/dev/brain).
# ~/dev/brain/runs: fsa-mail logs the doorbell to runs/external-sends.tsv.
ReadWritePaths=%h/.npm %h/scratch %h/dev/brain/runs
# Covers the harvest and both ExecStartPost steps (clones, pushes, doorbells).
TimeoutStartSec=300
