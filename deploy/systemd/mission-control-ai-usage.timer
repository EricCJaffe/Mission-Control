[Unit]
Description=Mission Control — AI usage meter, every 30 min by day, every 2 h overnight

[Timer]
# Eric, 2026-10-18 2:13 PM ET. ET times; the service holds a flock so runs
# never overlap, and normal runs parse only the last 2 days (see
# deploy/ai-usage/ubuntu-collect.sh). Persistent catches a missed run.
OnCalendar=*-*-* 06..23:00,30:00 America/New_York
OnCalendar=*-*-* 00,02,04:00:00 America/New_York
Persistent=true
RandomizedDelaySec=60
AccuracySec=30s

[Install]
WantedBy=timers.target
